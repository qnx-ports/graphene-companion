# Alpine-Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=graphene
pkgver=1.10.8
pkgrel=0
pkgdesc="A thin layer of graphic data types"
url="http://ebassi.github.io/graphene/"
arch="all"
license="MIT"
depends="glib"
makedepends="meson glib-dev gobject-introspection-dev"
options="!check"
subpackages="$pkgname-dev"
source="https://github.com/ebassi/graphene/archive/$pkgver/graphene-$pkgver.tar.gz
        0007-remove-obsolete-isinff-calls.patch
        0008-remove-finite-math-only-flag.patch
"

build() {
    abuild-meson \
        -Db_lto=false \
        -Darm_neon=true \
        -Dinstalled_tests=false \
        -Dintrospection=enabled \
        -Dtests=false \
        . output
    meson compile -C output
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

